<?xml version="1.0"?>
<ruleset name="Database">
    <description>Database coding standard.</description>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="warning-severity" value="0"/>

    <file>src</file>
    <file>tests</file>

    <exclude-pattern>src/Generated/*</exclude-pattern>

    <rule ref="PSR12"/>
</ruleset>
